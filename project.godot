; Liv og de ti hjemveje — Godot 4.6.3, Compatibility
config_version=5

[application]
config/name="Liv og de ti hjemveje"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/ui/app-icon.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/handheld/orientation=6
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.08, 0.07, 1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[gui]
theme/default_font_multichannel_signed_distance_field=true
